# Variables de entorno del backend de Conecta Comuna

# Puerto donde escucha la API
PORT=4000

# Supabase (crear cuenta en https://supabase.com)
SUPABASE_URL=tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Secreto para firmar JWT del panel
JWT_SECRET=cambia-esto-en-produccion